              "raw": "{\n  \"interconnectName\": \"<string>\",\n  \"bandwidth\": \"<string>\",\n  \"location\": \"<string>\",\n  \"lagId\": \"<string>\",\n  \"tags\": [\n    {\n      \"key\": \"N+\",\n      \"value\": \"_Zpp/:=:Z\"\n    }\n  ],\n  \"providerName\": \"<string>\"\n}",
