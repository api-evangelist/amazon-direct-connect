              "mode": "raw",
              "raw": "{\n  \"connectionId\": \"<string>\",\n  \"newTransitVirtualInterface\": {\n    \"virtualInterfaceName\": \"<string>\",\n    \"vlan\": \"<integer>\",\n    \"asn\": \"<integer>\",\n    \"mtu\": \"<integer>\",\n    \"authKey\": \"<string>\",\n    \"amazonAddress\": \"<string>\",\n    \"customerAddress\": \"<string>\",\n    \"addressFamily\": \"ipv6\",\n    \"directConnectGatewayId\": \"<string>\",\n    \"tags\": [\n      {\n        \"key\": \"_@p\",\n        \"value\": \"-=\"\n      }\n    ],\n    \"enableSiteLink\": \"<boolean>\"\n  }\n}",
