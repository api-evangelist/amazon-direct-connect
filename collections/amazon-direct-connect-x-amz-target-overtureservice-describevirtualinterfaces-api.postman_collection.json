          "name": "Describe Virtual Interfaces",
          "request": {
            "name": "Describe Virtual Interfaces",
            "description": {
              "content": "<p>Displays all virtual interfaces for an Amazon Web Services account. Virtual interfaces deleted fewer than 15 minutes before you make the request are also returned. If you specify a connection ID, only the virtual interfaces associated with the connection are returned. If you specify a virtual interface ID, then only a single virtual interface is returned.</p> <p>A virtual interface (VLAN) transmits the traffic between the Direct Connect location and the customer network.</p>",
              "type": "text/plain"
            },
